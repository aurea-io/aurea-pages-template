[Unit]
Description=Aurea image deployer
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=simple
User=@AUREA_USER@
WorkingDirectory=@AUREA_DIR@
Environment=HOME=/tmp/aurea-deployer-home
Environment=DOCKER_CONFIG=/tmp/aurea-deployer-docker-config
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p /tmp/aurea-deployer-home /tmp/aurea-deployer-docker-config
ExecStartPre=/usr/bin/docker info
ExecStart=/usr/bin/env python3 @AUREA_DIR@/scripts/deployment/local-deployer.py --compose @AUREA_DIR@/compose.yaml --env-file @AUREA_ENV_FILE@ --interval 300
Restart=always
RestartSec=15
NoNewPrivileges=true
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
